<style>
  :root {
    --bg: #fafaf9;
    --card: #ffffff;
    --text: #1c1917;
    --muted: #78716c;
    --border: #e7e5e4;
    --accent: #4702ad;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #1c1917;
      --card: #292524;
      --text: #f5f5f4;
      --muted: #a8a29e;
      --border: #44403c;
      --accent: #a78bfa;
    }
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    padding: 2.5rem 1.25rem;
    background: var(--bg);
    color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    line-height: 1.5;
  }
  .container { max-width: 960px; margin: 0 auto; }
  header { margin-bottom: 2rem; }
  h1 { font-size: 1.5rem; margin: 0 0 0.25rem; }
  .meta { color: var(--muted); font-size: 0.9rem; }
  .layout { display: flex; align-items: flex-start; gap: 2.5rem; }
  .sidebar {
    flex: 0 0 160px;
    position: sticky;
    top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .sidebar a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.88rem;
    padding: 0.3rem 0 0.3rem 0.65rem;
    border-left: 2px solid var(--border);
  }
  .sidebar a:hover { color: var(--accent); border-left-color: var(--accent); }
  .sidebar a.sub { padding-left: 1.3rem; font-size: 0.8rem; }
  .wrap { flex: 1 1 auto; min-width: 0; max-width: 720px; }
  @media (max-width: 780px) {
    .layout { flex-direction: column; }
    .sidebar {
      position: static;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.4rem 1rem;
      padding-bottom: 0.75rem;
      margin-bottom: 1rem;
      border-bottom: 1px solid var(--border);
    }
    .sidebar a { border-left: none; padding: 0.15rem 0; }
  }
  h2.section {
    font-size: 1.2rem;
    margin: 2.5rem 0 1rem;
    padding-bottom: 0.4rem;
    border-bottom: 2px solid var(--accent);
    scroll-margin-top: 1rem;
  }
  h3.subsection {
    font-size: 1rem;
    margin: 1.75rem 0 0.75rem;
    color: var(--accent);
    scroll-margin-top: 1rem;
  }
  .discovery-line { margin: 0 0 1rem; }
  .discovery-line a { color: var(--accent); text-decoration: none; }
  .discovery-line a:hover { text-decoration: underline; }
  ul.summary-bullets {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 10px;
    margin: 0;
    padding: 0.9rem 1.1rem 0.9rem 2rem;
  }
  ul.summary-bullets li { margin-bottom: 0.55rem; }
  ul.summary-bullets li:last-child { margin-bottom: 0; }
  .bullet-links { margin-left: 0.4rem; font-size: 0.85rem; }
  .bullet-links a { color: var(--accent); text-decoration: none; }
  .bullet-links a:hover { text-decoration: underline; }
  .bullet-links .sep { color: var(--muted); margin: 0 0.3rem; }
  .empty { color: var(--muted); font-style: italic; }
  .group {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 0.85rem 1.1rem;
    margin-bottom: 0.6rem;
  }
  .group .heading { font-weight: 600; }
  .group .heading .sources { font-weight: 400; color: var(--muted); font-size: 0.85rem; }
  .group .note { margin: 0.3rem 0 0; color: var(--muted); font-size: 0.9rem; }
  .group .models { margin: 0.3rem 0 0; color: var(--muted); font-size: 0.9rem; }
  .group .links { margin-top: 0.4rem; font-size: 0.9rem; }
  .group .links a { color: var(--accent); text-decoration: none; }
  .group .links a:hover { text-decoration: underline; }
  .group .links .sep { color: var(--muted); margin: 0 0.35rem; }
  .group ul.specs { margin: 0.5rem 0 0; padding-left: 1.15rem; font-size: 0.88rem; }
  .group ul.specs li { margin-bottom: 0.15rem; }
  ul.archive-list { list-style: none; margin: 0; padding: 0; }
  ul.archive-list li { margin-bottom: 0.5rem; }
  ul.archive-list a {
    display: block;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 0.75rem 1rem;
    color: var(--text);
    text-decoration: none;
    font-weight: 600;
  }
  ul.archive-list a:hover { border-color: var(--accent); color: var(--accent); }
</style>
