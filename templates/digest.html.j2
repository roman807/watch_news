<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Watch News — {{ date_str }}</title>
{% include "_style.html.j2" %}
</head>
<body>
<div class="container">
  {% if not grouped %}
    <header>
      <a class="back-link" href="index.html">← Back to archive</a>
      <h1>Daily Watch News Digest</h1>
      <div class="meta">{{ date_str }} {{ time_str }} · {{ total }} new article{{ "s" if total != 1 else "" }}</div>
    </header>
    <p class="empty">No new articles since the last run.</p>
  {% else %}
  <div class="layout">
    <nav class="sidebar">
      <a href="#summary">Summary</a>
      <a href="#business-news">Business News</a>
      <a href="#new-releases">New Releases</a>
      <a href="#brands-covered">Brands Covered</a>
      <a href="#microbrands" class="sub">Microbrands</a>
      <a href="#independents" class="sub">Independents</a>
      <a href="#mainstream-brands" class="sub">Mainstream Brands</a>
    </nav>
    <div class="wrap">
      <header>
        <a class="back-link" href="index.html">← Back to archive</a>
        <h1>Daily Watch News Digest</h1>
        <div class="meta">{{ date_str }} {{ time_str }} · {{ total }} new article{{ "s" if total != 1 else "" }}</div>
      </header>

  <h2 class="section" id="summary">Summary</h2>
  {% if source_counts %}
    <p class="discovery-line">
      We discovered {{ total }} new article{{ "s" if total != 1 else "" }}{% if source_counts %} — {% for sc in source_counts %}{{ sc.count }} from <a href="{{ sc.homepage }}" target="_blank" rel="noopener">{{ sc.name }}</a>{% if not loop.last %}{% if loop.revindex0 == 1 %}{{ ", and " if source_counts|length > 2 else " and " }}{% else %}, {% endif %}{% endif %}{% endfor %}{% endif %}.
    </p>
  {% endif %}
  {% if zero_sources %}
    <p class="discovery-line">
      No new articles from {% for s in zero_sources %}<a href="{{ s.homepage }}" target="_blank" rel="noopener">{{ s.name }}</a>{% if not loop.last %}{% if loop.revindex0 == 1 %} and {% else %}, {% endif %}{% endif %}{% endfor %}.
    </p>
  {% endif %}
  {% if analysis.summary_bullets %}
    <ul class="summary-bullets">
      {% for bullet in analysis.summary_bullets %}
        <li>
          {{ bullet.text }}
          {% if bullet.urls %}
            <span class="bullet-links">{% for url in bullet.urls %}<a href="{{ url }}" target="_blank" rel="noopener">{{ source_by_url.get(url, url) }}</a>{% if not loop.last %}<span class="sep">·</span>{% endif %}{% endfor %}</span>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <p class="empty">No summary available.</p>
  {% endif %}

  <h2 class="section" id="business-news">Business News</h2>
  {% if analysis.business_news %}
    {% for item in analysis.business_news %}
      <div class="group">
        <div class="heading">{{ item.topic }}</div>
        <p class="note">{{ item.summary }}</p>
        <div class="links">
          {% for url in item.urls %}<a href="{{ url }}" target="_blank" rel="noopener">{{ source_by_url.get(url, "") }}: {{ title_by_url.get(url, url) }}</a>{% endfor %}
        </div>
      </div>
    {% endfor %}
  {% else %}
    <p class="empty">No business news today.</p>
  {% endif %}

  <h2 class="section" id="new-releases">New Releases</h2>
  {% if analysis.new_releases %}
    {% for group in analysis.new_releases %}
      {% set specs = group.specs %}
      <div class="group">
        <div class="heading">{{ group.brand }} — {{ group.model }}</div>
        {% if specs.size or specs.movement or specs.water_resistance or specs.case_material or specs.notable_features or specs.price %}
          <ul class="specs">
            {% if specs.size %}<li>Size: {{ specs.size }}</li>{% endif %}
            {% if specs.movement %}<li>Movement: {{ specs.movement }}</li>{% endif %}
            {% if specs.water_resistance %}<li>Water resistance: {{ specs.water_resistance }}</li>{% endif %}
            {% if specs.case_material %}<li>Case material: {{ specs.case_material }}</li>{% endif %}
            {% for feature in specs.notable_features %}<li>{{ feature }}</li>{% endfor %}
            {% if specs.price %}<li>Price: {{ specs.price }}</li>{% endif %}
          </ul>
        {% endif %}
        <div class="links">
          {% for url in group.urls %}<a href="{{ url }}" target="_blank" rel="noopener">{{ source_by_url.get(url, "") }}: {{ title_by_url.get(url, url) }}</a>{% endfor %}
        </div>
      </div>
    {% endfor %}
  {% else %}
    <p class="empty">No new releases identified today.</p>
  {% endif %}

  <h2 class="section" id="brands-covered">Brands Covered</h2>

  <h3 class="subsection" id="microbrands">Microbrands</h3>
  {% if analysis.microbrands %}
    {% for group in analysis.microbrands %}
      <div class="group">
        <div class="heading">{{ group.brand }}{% if group.model %} — {{ group.model }}{% endif %}</div>
        {% if group.note %}<p class="note">{{ group.note }}</p>{% endif %}
        <div class="links">
          {% for url in group.urls %}<a href="{{ url }}" target="_blank" rel="noopener">{{ source_by_url.get(url, "") }}: {{ title_by_url.get(url, url) }}</a>{% endfor %}
        </div>
      </div>
    {% endfor %}
  {% else %}
    <p class="empty">No microbrand articles today.</p>
  {% endif %}

  <h3 class="subsection" id="independents">Independents</h3>
  {% if analysis.independents %}
    {% for group in analysis.independents %}
      <div class="group">
        <div class="heading">{{ group.brand }}{% if group.model %} — {{ group.model }}{% endif %}</div>
        {% if group.note %}<p class="note">{{ group.note }}</p>{% endif %}
        <div class="links">
          {% for url in group.urls %}<a href="{{ url }}" target="_blank" rel="noopener">{{ source_by_url.get(url, "") }}: {{ title_by_url.get(url, url) }}</a>{% endfor %}
        </div>
      </div>
    {% endfor %}
  {% else %}
    <p class="empty">No independent-brand articles today.</p>
  {% endif %}

  <h3 class="subsection" id="mainstream-brands">Mainstream Brands</h3>
  {% if analysis.brands_discussed %}
    {% for group in analysis.brands_discussed %}
      <div class="group">
        <div class="heading">{{ group.brand }}</div>
        {% if group.models %}<p class="models">{{ group.models|join(", ") }}</p>{% endif %}
        <div class="links">
          {% for url in group.urls %}<a href="{{ url }}" target="_blank" rel="noopener">{{ source_by_url.get(url, "") }}: {{ title_by_url.get(url, url) }}</a>{% endfor %}
        </div>
      </div>
    {% endfor %}
  {% else %}
    <p class="empty">No mainstream brands identified today.</p>
  {% endif %}

    </div>
  </div>
  {% endif %}
</div>
</body>
</html>
