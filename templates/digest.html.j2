<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Watch News — {{ date_str }}</title>
{% include "_style.html.j2" %}
</head>
<body>
<div class="container">
  {% if not grouped %}
    <header>
      <h1>Watch News Digest</h1>
      <div class="meta">{{ date_str }} {{ time_str }} · {{ total }} new article{{ "s" if total != 1 else "" }}</div>
    </header>
    <p class="empty">No new articles since the last run.</p>
  {% else %}
  <div class="layout">
    <nav class="sidebar">
      <a href="#summary">Summary</a>
      <a href="#microbrands">Microbrands</a>
      <a href="#mainstream-brands">Mainstream Brands</a>
      <a href="#new-releases">New Releases</a>
      <a href="#business-news">Business News</a>
    </nav>
    <div class="wrap">
      <header>
        <h1>Watch News Digest</h1>
        <div class="meta">{{ date_str }} {{ time_str }} · {{ total }} new article{{ "s" if total != 1 else "" }}</div>
      </header>

  <h2 class="section" id="summary">Summary</h2>
  {% if analysis.summary_bullets %}
    <ul class="summary-bullets">
      {% for bullet in analysis.summary_bullets %}
        <li>
          {{ bullet.text }}
          {% if bullet.urls %}
            <span class="bullet-links">{% for url in bullet.urls %}<a href="{{ url }}" target="_blank" rel="noopener">{{ title_by_url.get(url, url) }}</a>{% if not loop.last %}<span class="sep">·</span>{% endif %}{% endfor %}</span>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <p class="empty">No summary available.</p>
  {% endif %}

  <h2 class="section" id="microbrands">Microbrands</h2>
  {% if analysis.microbrands %}
    {% for group in analysis.microbrands %}
      <div class="group">
        <div class="heading">{{ group.brand }}{% if group.model %} — {{ group.model }}{% endif %}{% if group.sources %} <span class="sources">({{ group.sources|join(", ") }})</span>{% endif %}</div>
        {% if group.note %}<p class="note">{{ group.note }}</p>{% endif %}
        <div class="links">
          {% for url in group.urls %}<a href="{{ url }}" target="_blank" rel="noopener">{{ title_by_url.get(url, url) }}</a>{% if not loop.last %}<span class="sep">·</span>{% endif %}{% endfor %}
        </div>
      </div>
    {% endfor %}
  {% else %}
    <p class="empty">No microbrand articles today.</p>
  {% endif %}

  <h2 class="section" id="mainstream-brands">Mainstream Brands</h2>
  {% if analysis.brands_discussed %}
    {% for group in analysis.brands_discussed %}
      <div class="group">
        <div class="heading">{{ group.brand }}{% if group.sources %} <span class="sources">({{ group.sources|join(", ") }})</span>{% endif %}</div>
        {% if group.models %}<p class="models">{{ group.models|join(", ") }}</p>{% endif %}
        <div class="links">
          {% for url in group.urls %}<a href="{{ url }}" target="_blank" rel="noopener">{{ title_by_url.get(url, url) }}</a>{% if not loop.last %}<span class="sep">·</span>{% endif %}{% endfor %}
        </div>
      </div>
    {% endfor %}
  {% else %}
    <p class="empty">No mainstream brands identified today.</p>
  {% endif %}

  <h2 class="section" id="new-releases">New Releases</h2>
  {% if analysis.new_releases %}
    {% for group in analysis.new_releases %}
      {% set specs = group.specs %}
      <div class="group">
        <div class="heading">{{ group.brand }} — {{ group.model }}{% if group.sources %} <span class="sources">({{ group.sources|join(", ") }})</span>{% endif %}</div>
        {% if specs.size or specs.movement or specs.water_resistance or specs.case_material or specs.notable_features or specs.price %}
          <ul class="specs">
            {% if specs.size %}<li>Size: {{ specs.size }}</li>{% endif %}
            {% if specs.movement %}<li>Movement: {{ specs.movement }}</li>{% endif %}
            {% if specs.water_resistance %}<li>Water resistance: {{ specs.water_resistance }}</li>{% endif %}
            {% if specs.case_material %}<li>Case material: {{ specs.case_material }}</li>{% endif %}
            {% for feature in specs.notable_features %}<li>{{ feature }}</li>{% endfor %}
            {% if specs.price %}<li>Price: {{ specs.price }}</li>{% endif %}
          </ul>
        {% endif %}
        <div class="links">
          {% for url in group.urls %}<a href="{{ url }}" target="_blank" rel="noopener">{{ title_by_url.get(url, url) }}</a>{% if not loop.last %}<span class="sep">·</span>{% endif %}{% endfor %}
        </div>
      </div>
    {% endfor %}
  {% else %}
    <p class="empty">No new releases identified today.</p>
  {% endif %}

  <h2 class="section" id="business-news">Business News</h2>
  {% if analysis.business_news %}
    {% for item in analysis.business_news %}
      <div class="group">
        <div class="heading">{{ item.topic }}{% if item.sources %} <span class="sources">({{ item.sources|join(", ") }})</span>{% endif %}</div>
        <p class="note">{{ item.summary }}</p>
        <div class="links">
          {% for url in item.urls %}<a href="{{ url }}" target="_blank" rel="noopener">{{ title_by_url.get(url, url) }}</a>{% if not loop.last %}<span class="sep">·</span>{% endif %}{% endfor %}
        </div>
      </div>
    {% endfor %}
  {% else %}
    <p class="empty">No business news today.</p>
  {% endif %}

    </div>
  </div>
  {% endif %}
</div>
</body>
</html>
