<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Watch News — {{ date_str }}</title>
<style>
  :root {
    --bg: #fafaf9;
    --card: #ffffff;
    --text: #1c1917;
    --muted: #78716c;
    --border: #e7e5e4;
    --accent: #92400e;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #1c1917;
      --card: #292524;
      --text: #f5f5f4;
      --muted: #a8a29e;
      --border: #44403c;
      --accent: #d97706;
    }
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    padding: 2.5rem 1.25rem;
    background: var(--bg);
    color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    line-height: 1.5;
  }
  .container { max-width: 960px; margin: 0 auto; }
  header { margin-bottom: 2rem; }
  h1 { font-size: 1.5rem; margin: 0 0 0.25rem; }
  .meta { color: var(--muted); font-size: 0.9rem; }
  .layout { display: flex; align-items: flex-start; gap: 2.5rem; }
  .sidebar {
    flex: 0 0 160px;
    position: sticky;
    top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .sidebar a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.88rem;
    padding: 0.3rem 0 0.3rem 0.65rem;
    border-left: 2px solid var(--border);
  }
  .sidebar a:hover { color: var(--accent); border-left-color: var(--accent); }
  .wrap { flex: 1 1 auto; min-width: 0; max-width: 720px; }
  @media (max-width: 780px) {
    .layout { flex-direction: column; }
    .sidebar {
      position: static;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.4rem 1rem;
      padding-bottom: 0.75rem;
      margin-bottom: 1rem;
      border-bottom: 1px solid var(--border);
    }
    .sidebar a { border-left: none; padding: 0.15rem 0; }
  }
  h2.section {
    font-size: 1.2rem;
    margin: 2.5rem 0 1rem;
    padding-bottom: 0.4rem;
    border-bottom: 2px solid var(--accent);
    scroll-margin-top: 1rem;
  }
  ul.summary-bullets {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 10px;
    margin: 0;
    padding: 0.9rem 1.1rem 0.9rem 2rem;
  }
  ul.summary-bullets li { margin-bottom: 0.55rem; }
  ul.summary-bullets li:last-child { margin-bottom: 0; }
  .bullet-links { margin-left: 0.4rem; font-size: 0.85rem; }
  .bullet-links a { color: var(--accent); text-decoration: none; }
  .bullet-links a:hover { text-decoration: underline; }
  .bullet-links .sep { color: var(--muted); margin: 0 0.3rem; }
  .empty { color: var(--muted); font-style: italic; }
  .group {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 0.85rem 1.1rem;
    margin-bottom: 0.6rem;
  }
  .group .heading { font-weight: 600; }
  .group .heading .sources { font-weight: 400; color: var(--muted); font-size: 0.85rem; }
  .group .note { margin: 0.3rem 0 0; color: var(--muted); font-size: 0.9rem; }
  .group .models { margin: 0.3rem 0 0; color: var(--muted); font-size: 0.9rem; }
  .group .links { margin-top: 0.4rem; font-size: 0.9rem; }
  .group .links a { color: var(--accent); text-decoration: none; }
  .group .links a:hover { text-decoration: underline; }
  .group .links .sep { color: var(--muted); margin: 0 0.35rem; }
  .group ul.specs { margin: 0.5rem 0 0; padding-left: 1.15rem; font-size: 0.88rem; }
  .group ul.specs li { margin-bottom: 0.15rem; }
</style>
</head>
<body>
<div class="container">
  <header>
    <h1>Watch News Digest</h1>
    <div class="meta">{{ date_str }} {{ time_str }} · {{ total }} new article{{ "s" if total != 1 else "" }}</div>
  </header>

  {% if not grouped %}
    <p class="empty">No new articles since the last run.</p>
  {% else %}
  <div class="layout">
    <nav class="sidebar">
      <a href="#summary">Summary</a>
      <a href="#microbrands">Microbrands</a>
      <a href="#mainstream-brands">Mainstream Brands</a>
      <a href="#new-releases">New Releases</a>
      <a href="#business-news">Business News</a>
    </nav>
    <div class="wrap">

  <h2 class="section" id="summary">Summary</h2>
  {% if analysis.summary_bullets %}
    <ul class="summary-bullets">
      {% for bullet in analysis.summary_bullets %}
        <li>
          {{ bullet.text }}
          {% if bullet.urls %}
            <span class="bullet-links">{% for url in bullet.urls %}<a href="{{ url }}" target="_blank" rel="noopener">{{ title_by_url.get(url, url) }}</a>{% if not loop.last %}<span class="sep">·</span>{% endif %}{% endfor %}</span>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <p class="empty">No summary available.</p>
  {% endif %}

  <h2 class="section" id="microbrands">Microbrands</h2>
  {% if analysis.microbrands %}
    {% for group in analysis.microbrands %}
      <div class="group">
        <div class="heading">{{ group.brand }}{% if group.model %} — {{ group.model }}{% endif %}{% if group.sources %} <span class="sources">({{ group.sources|join(", ") }})</span>{% endif %}</div>
        {% if group.note %}<p class="note">{{ group.note }}</p>{% endif %}
        <div class="links">
          {% for url in group.urls %}<a href="{{ url }}" target="_blank" rel="noopener">{{ title_by_url.get(url, url) }}</a>{% if not loop.last %}<span class="sep">·</span>{% endif %}{% endfor %}
        </div>
      </div>
    {% endfor %}
  {% else %}
    <p class="empty">No microbrand articles today.</p>
  {% endif %}

  <h2 class="section" id="mainstream-brands">Mainstream Brands</h2>
  {% if analysis.brands_discussed %}
    {% for group in analysis.brands_discussed %}
      <div class="group">
        <div class="heading">{{ group.brand }}{% if group.sources %} <span class="sources">({{ group.sources|join(", ") }})</span>{% endif %}</div>
        {% if group.models %}<p class="models">{{ group.models|join(", ") }}</p>{% endif %}
        <div class="links">
          {% for url in group.urls %}<a href="{{ url }}" target="_blank" rel="noopener">{{ title_by_url.get(url, url) }}</a>{% if not loop.last %}<span class="sep">·</span>{% endif %}{% endfor %}
        </div>
      </div>
    {% endfor %}
  {% else %}
    <p class="empty">No mainstream brands identified today.</p>
  {% endif %}

  <h2 class="section" id="new-releases">New Releases</h2>
  {% if analysis.new_releases %}
    {% for group in analysis.new_releases %}
      {% set specs = group.specs %}
      <div class="group">
        <div class="heading">{{ group.brand }} — {{ group.model }}{% if group.sources %} <span class="sources">({{ group.sources|join(", ") }})</span>{% endif %}</div>
        {% if specs.size or specs.movement or specs.water_resistance or specs.case_material or specs.notable_features or specs.price %}
          <ul class="specs">
            {% if specs.size %}<li>Size: {{ specs.size }}</li>{% endif %}
            {% if specs.movement %}<li>Movement: {{ specs.movement }}</li>{% endif %}
            {% if specs.water_resistance %}<li>Water resistance: {{ specs.water_resistance }}</li>{% endif %}
            {% if specs.case_material %}<li>Case material: {{ specs.case_material }}</li>{% endif %}
            {% for feature in specs.notable_features %}<li>{{ feature }}</li>{% endfor %}
            {% if specs.price %}<li>Price: {{ specs.price }}</li>{% endif %}
          </ul>
        {% endif %}
        <div class="links">
          {% for url in group.urls %}<a href="{{ url }}" target="_blank" rel="noopener">{{ title_by_url.get(url, url) }}</a>{% if not loop.last %}<span class="sep">·</span>{% endif %}{% endfor %}
        </div>
      </div>
    {% endfor %}
  {% else %}
    <p class="empty">No new releases identified today.</p>
  {% endif %}

  <h2 class="section" id="business-news">Business News</h2>
  {% if analysis.business_news %}
    {% for item in analysis.business_news %}
      <div class="group">
        <div class="heading">{{ item.topic }}{% if item.sources %} <span class="sources">({{ item.sources|join(", ") }})</span>{% endif %}</div>
        <p class="note">{{ item.summary }}</p>
        <div class="links">
          {% for url in item.urls %}<a href="{{ url }}" target="_blank" rel="noopener">{{ title_by_url.get(url, url) }}</a>{% if not loop.last %}<span class="sep">·</span>{% endif %}{% endfor %}
        </div>
      </div>
    {% endfor %}
  {% else %}
    <p class="empty">No business news today.</p>
  {% endif %}

    </div>
  </div>
  {% endif %}
</div>
</body>
</html>
